package layout

import (
	"github.com/hfiorillo/site/models"
	"github.com/hfiorillo/site/paths"
)

templ Base(meta models.PageMeta) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ meta.Title }</title>
			<meta name="description" content={ meta.Description }/>
			<meta property="og:title" content={ meta.Title }/>
			<meta property="og:description" content={ meta.Description }/>
			<meta property="og:image" content={ meta.Image }/>
			<meta property="og:url" content={ meta.URL }/>
			<meta property="og:type" content="website"/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ meta.Title }/>
			<meta name="twitter:description" content={ meta.Description }/>
			<meta name="twitter:image" content={ meta.Image }/>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
			<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href={ templ.SafeURL(paths.StylesURL) }/>
			<link rel="icon" type="image/svg+xml" href={ paths.Favicon }/>
			if meta.Canonical != "" {
				<link rel="canonical" href={ meta.Canonical }/>
			}
			if meta.StructuredData != "" {
				<script type="application/ld+json">@templ.Raw(meta.StructuredData)</script>
			}
		</head>
		<body
			class="bg-base-100 min-h-screen"
			@keydown.escape.window="lb = null"
			x-data="{ lb: null }"
			@click="if ($event.target.tagName === 'IMG' && $event.target.closest('.prose')) lb = $event.target.src"
		>
			<a class="skip-link" href="#main-content">Skip to content</a>
			<div class="site-shell">
				<div class="brand-rail">@Brand()
</div>
				<nav class="site-navigation" aria-label="Site navigation">@SideNav()
</nav>
				<main id="main-content" class="site-main" tabindex="-1">
					{ children... }
				</main>
			</div>
			<div
				class="fixed top-0 left-0 h-0.5 bg-primary z-50"
				x-data="{ progress: 0 }"
				x-init="window.addEventListener('scroll', () => { const s = window.scrollY, d = document.documentElement.scrollHeight - window.innerHeight; progress = d > 0 ? Math.min((s / d) * 100, 100) : 0 })"
				:style="`width: ${progress}%`"
			></div>
			<div x-show="lb" @click="lb = null" class="fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4 cursor-pointer" style="display: none;">
				<img :src="lb" class="max-w-full max-h-full object-contain rounded-lg cursor-default" @click.stop alt=""/>
			</div>
		</body>
	</html>
}
