package layout

templ Brand() {
	<div class="flex flex-col items-center justify-start min-h-screen gap-4 px-4 pt-44">
		<a href="/"><div class="w-24 h-24 rounded-full bg-[#e74c3c] animate-hue"></div></a>
		<a href="/"><div class="w-24 h-24 rounded-full bg-[#e67e22] animate-hue" style="animation-delay:0.75s;"></div></a>
		<a href="/"><div class="w-24 h-24 rounded-full bg-[#f39c12] animate-hue" style="animation-delay:1.5s;"></div></a>
		<a href="/"><div class="w-24 h-24 rounded-full bg-[#2ecc71] animate-hue" style="animation-delay:2.25s;"></div></a>
		<a href="/"><div class="w-24 h-24 rounded-full bg-[#1abc9c] animate-hue" style="animation-delay:3s;"></div></a>
		<a href="/"><div class="w-24 h-24 rounded-full bg-[#3498db] animate-hue" style="animation-delay:3.75s;"></div></a>
		<a href="/"><div class="w-24 h-24 rounded-full bg-[#9b59b6] animate-hue" style="animation-delay:4.5s;"></div></a>
		<a href="/"><div class="w-24 h-24 rounded-full bg-[#e74c3c] animate-hue" style="animation-delay:5.25s;"></div></a>
	</div>
}
