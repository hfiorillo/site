package layout

import (
	"github.com/hfiorillo/site/paths"
	"github.com/hfiorillo/site/view/components/icons"
	navigation "github.com/hfiorillo/site/view/components/themeController"
)

templ SideNav() {
	<div class="navigation-inner">
		<div class="site-identity">
			<a href={ paths.Root }>Harry Fiorillo-Hughes</a>
			<p>Manchester, UK</p>
		</div>
		<div class="navigation-links">
			<a href={ paths.Root } class="sidenav-link text-lg text-base-content/50 hover:text-base-content transition-colors no-underline">Blog</a>
			<a href={ paths.Pictures } class="sidenav-link text-lg text-base-content/50 hover:text-base-content transition-colors no-underline">Pictures</a>
			<a href={ paths.Work } class="sidenav-link text-lg text-base-content/50 hover:text-base-content transition-colors no-underline">Work</a>
			<a href={ paths.Routes } class="sidenav-link text-lg text-base-content/50 hover:text-base-content transition-colors no-underline">Routes</a>
			<a href={ paths.AboutMe } class="sidenav-link text-lg text-base-content/50 hover:text-base-content transition-colors no-underline">About</a>
		</div>

		<div class="navigation-socials">
			<a href="https://www.github.com/hfiorillo" target="_blank" rel="noopener noreferrer" class="sidenav-link flex items-center gap-2 text-base text-base-content/50 hover:text-base-content transition-colors no-underline">
				<span class="w-4 h-4 text-[#333]">@icons.GitHub()</span>
				GitHub
			</a>
			<a href="https://www.instagram.com/harryfiorillo" target="_blank" rel="noopener noreferrer" class="sidenav-link flex items-center gap-2 text-base text-base-content/50 hover:text-base-content transition-colors no-underline">
				<span class="w-4 h-4 text-[#E4405F]">@icons.Instagram()</span>
				Instagram
			</a>
			<a href="https://www.komoot.com/user/1306431058067" target="_blank" rel="noopener noreferrer" class="sidenav-link flex items-center gap-2 text-base text-base-content/50 hover:text-base-content transition-colors no-underline">
				<span class="w-4 h-4 text-[#4CAF50]">@icons.Komoot()</span>
				Komoot
			</a>
			<a href="https://www.strava.com/athletes/19890295" target="_blank" rel="noopener noreferrer" class="sidenav-link flex items-center gap-2 text-base text-base-content/50 hover:text-base-content transition-colors no-underline">
				<span class="w-4 h-4 text-[#FC4C02]">@icons.Strava()</span>
				Strava
			</a>
		</div>

		<div class="navigation-theme">
			@navigation.ThemeController()
			<a href={ paths.Feed } class="sidenav-link-tight">RSS feed ↗</a>
		</div>

		<div class="navigation-colophon">
			<p>Learn more about this <a href={ paths.AboutThisSite } class="sidenav-link-tight text-base-content/50 hover:text-base-content no-underline">site 🌟</a>.</p>
		</div>
	</div>
}
