package layout

import (
	"github.com/hfiorillo/site/view/components/icons"
	navigation "github.com/hfiorillo/site/view/components/themeController"
)

templ SideNav() {
	<div class="flex flex-col gap-6 pt-12">
		<div class="flex flex-col gap-2">
			<a href="/" class="text-lg text-base-content/50 hover:text-base-content transition-colors no-underline">Home</a>
			<a href="/routes" class="text-lg text-base-content/50 hover:text-base-content transition-colors no-underline">Routes</a>
			<a href="/aboutme" class="text-lg text-base-content/50 hover:text-base-content transition-colors no-underline">About</a>
		</div>

		<div class="border-t border-dotted border-base-content/20 pt-4 flex flex-col gap-3">
			<a href="https://www.github.com/hfiorillo" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-base text-base-content/50 hover:text-base-content transition-colors no-underline">
				<span class="w-4 h-4">@icons.GitHub()</span>
				GitHub
			</a>
			<a href="https://www.instagram.com/harryfiorillo" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-base text-base-content/50 hover:text-base-content transition-colors no-underline">
				<span class="w-4 h-4">@icons.Instagram()</span>
				Instagram
			</a>
			<a href="https://www.komoot.com/user/1306431058067" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-base text-base-content/50 hover:text-base-content transition-colors no-underline">
				<span class="w-4 h-4">@icons.Komoot()</span>
				Komoot
			</a>
			<a href="https://www.strava.com/athletes/19890295" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-base text-base-content/50 hover:text-base-content transition-colors no-underline">
				<span class="w-4 h-4">@icons.Strava()</span>
				Strava
			</a>
		</div>

		<div class="border-t border-dotted border-base-content/20 pt-4 text-sm text-base-content/30 flex items-start gap-2">
			<div class="opacity-30 hover:opacity-60 transition-opacity mt-0.5 flex-shrink-0">
				@navigation.ThemeController()
			</div>
			<div>
				<p>Harry Fiorillo-Hughes</p>
				<p>Manchester, UK</p>
			</div>
		</div>

		<div class="border-t border-dotted border-base-content/20 pt-4 text-sm text-base-content/30">
			<p>Learn more about this site <a href="/about-this-site" class="text-base-content/50 hover:text-base-content no-underline">here</a>.</p>
		</div>
	</div>
}
