package pages

import (
 "fmt"
 "github.com/hfiorillo/site/models"
 "github.com/hfiorillo/site/view/layout"
)

templ Pictures(post *models.BlogPost, years []models.GalleryYear, meta models.PageMeta) {
 @layout.Base(meta) {
  <h1 class="text-3xl font-bold mb-6">{ post.Title }</h1>
  <div class="gallery-intro">@templ.Raw(post.Content)</div>
  for _, group := range years {
   <section class="gallery-year" aria-label={ fmt.Sprint(group.Year) }>
    <h2 class="gallery-year-heading">{ fmt.Sprint(group.Year) } <span>{ fmt.Sprintf("%d photos",len(group.Photos)) }</span></h2>
    <div class="photo-gallery">
     for _, photo := range group.Photos {
      <figure class="gallery-photo">
       <a class="gallery-photo-link" href={ templ.SafeURL(photo.Original) } data-title={ photo.Title } data-post-url={ photo.PostURL } @click.prevent="lbTitle = $el.dataset.title; lbPost = $el.dataset.postUrl; lb = $el.href" aria-label={ "Open full-size photo from " + photo.Title }>
        <img src={ photo.Preview } width={ fmt.Sprint(photo.Width) } height={ fmt.Sprint(photo.Height) } alt={ "Photo from " + photo.Title } loading="lazy" decoding="async"/>
       </a>
      </figure>
     }
    </div>
   </section>
  }
 }
}
