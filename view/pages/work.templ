package pages

import (
	"github.com/hfiorillo/site/models"
	"github.com/hfiorillo/site/view/layout"
)

templ Work(post *models.BlogPost, posts []*models.BlogPost, meta models.PageMeta) {
	@layout.Base(meta) {
		<h1 class="text-3xl font-bold mb-6">{ post.Title }</h1>
		<div class="prose prose-lg max-w-none">
			@templ.Raw(post.Content)
		</div>
		for i, entry := range posts {
			if i > 0 {
				<hr class="border-0 border-t border-dotted border-base-content/20 my-0"/>
			}
			@BlogCard(entry)
		}
	}
}
