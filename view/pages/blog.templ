package pages

import (
	"fmt"
	"strings"
	"net/url"
	"time"

	"github.com/hfiorillo/site/models"
	"github.com/hfiorillo/site/paths"
	"github.com/hfiorillo/site/view/layout"
)

templ Blog(posts []*models.BlogPost, category string, meta models.PageMeta, recent []*models.BlogPost, old []*models.BlogPost) {
	@layout.Base(meta) {
		if category == "" {
			<h1 class="text-3xl font-bold mb-6">Blog</h1>
		}
		if category != "" {
			<h1 class="text-3xl font-bold mb-6">{ titleCase(category) }</h1>
			<a href={ paths.Blog } class="text-base text-base-content/40 hover:text-primary no-underline">all posts</a>
		}
		if len(posts) == 0 {
			<p class="text-base-content/40 mt-12">No posts yet.</p>
		} else {
			for i, post := range recent {
				if i > 0 {
					<hr class="border-0 border-t border-dotted border-base-content/20 my-0"/>
				}
				@BlogCard(post)
			}
			if len(old) > 0 {
				<details class="archive">
					<summary>
						{ fmt.Sprintf("Older posts (%d)", len(old)) }
					</summary>
					<div class="mt-4">
						for i, post := range old {
							if i > 0 {
								<hr class="border-0 border-t border-dotted border-base-content/20"/>
							}
							@BlogCard(post)
						}
					</div>
				</details>
			}
		}
	}
}

templ BlogCard(post *models.BlogPost) {
	<article class="journal-entry" itemscope itemtype="https://schema.org/BlogPosting">
		<meta itemprop="author" content="Harry Fiorillo"/>
		<div class="entry-meta">
			<time datetime={ post.Date.Format("2006-01-02") } title={ post.Date.Format("02 January 2006") } itemprop="datePublished">posted { timeAgo(post.Date) }</time>
			<span>by Harry Fiorillo</span>
		</div>
		<a href={ templ.SafeURL(paths.Blog + "/" + post.Filename) } class="entry-title-link" itemprop="url">
			<h2 class="entry-title" itemprop="headline">{ post.Title }</h2>
		</a>
		<p class="entry-description" itemprop="description">{ post.Description }</p>
		if post.Metadata.PreviewImage != "" {
			<a href={ templ.SafeURL(paths.Blog + "/" + post.Filename) } class="entry-image" tabindex="-1" aria-hidden="true">
				<img src={ post.Metadata.PreviewImage } alt="" loading="lazy" decoding="async"/>
			</a>
		}
		if len(post.Metadata.Categories) > 0 {
			<a class="entry-category" href={ templ.SafeURL(paths.Blog + "?" + paths.BlogQueryCat + "=" + url.QueryEscape(post.Metadata.Categories[0])) }>{ post.Metadata.Categories[0] }</a>
		}
	</article>
}

templ BlogPage(post *models.BlogPost, prev *models.BlogPost, next *models.BlogPost, meta models.PageMeta) {
	@layout.Base(meta) {
		if meta.StructuredData != "" {
			<script type="application/ld+json">@templ.Raw(meta.StructuredData)</script>
		}
		<article itemscope itemtype="https://schema.org/BlogPosting">
			<meta itemprop="datePublished" content={ post.Date.Format("2006-01-02") }/>
			<meta itemprop="author" content="Harry Fiorillo"/>
			<h1 class="post-title" itemprop="headline">{ post.Title }</h1>
			<p class="entry-meta post-meta">
				<time datetime={ post.Date.Format("2006-01-02") }>{ post.Date.Format("02 January 2006") }</time>
				<span aria-hidden="true"> / </span>
				{ fmt.Sprintf("%d min read", post.ReadTimeMinutes) }
			</p>
			if post.Description != "" {
				<p class="post-deck" itemprop="description">{ post.Description }</p>
			}
			<hr class="border-0 border-t border-dotted border-base-content/20 my-8"/>
			<div class="prose prose-lg reading-text" itemprop="articleBody">
				@templ.Raw(post.Content)
			</div>
			if len(post.Metadata.Tags) > 0 {
				<div class="flex flex-wrap gap-3 mt-8 not-prose">
					for _, tag := range post.Metadata.Tags {
						<a href={ templ.SafeURL(paths.Blog + "?" + paths.BlogQueryTag + "=" + url.QueryEscape(tag)) } class="text-lg text-base-content/40 hover:text-primary no-underline">{ tag }</a>
					}
				</div>
			}
			<hr class="border-0 border-t border-dotted border-base-content/20 my-8"/>
			<div class="post-pagination not-prose">
				if prev != nil {
					<a href={ templ.SafeURL(paths.Blog + "/" + prev.Filename) } class="text-lg text-base-content/60 hover:text-primary no-underline">&larr; { prev.Title }</a>
				} else {
					<div></div>
				}
				if next != nil {
					<a href={ templ.SafeURL(paths.Blog + "/" + next.Filename) } class="text-lg text-base-content/60 hover:text-primary no-underline">{ next.Title } &rarr;</a>
				}
			</div>
		</article>
	}
}

func timeAgo(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		m := int(d.Minutes())
		if m == 1 { return "1 minute ago" }
		return fmt.Sprintf("%d minutes ago", m)
	case d < 24*time.Hour:
		h := int(d.Hours())
		if h == 1 { return "1 hour ago" }
		return fmt.Sprintf("%d hours ago", h)
	case d < 30*24*time.Hour:
		days := int(d.Hours() / 24)
		if days == 1 { return "1 day ago" }
		return fmt.Sprintf("%d days ago", days)
	case d < 365*24*time.Hour:
		months := int(d.Hours() / 24 / 30)
		if months == 1 { return "1 month ago" }
		return fmt.Sprintf("%d months ago", months)
	default:
		years := int(d.Hours() / 24 / 365)
		if years == 1 { return "1 year ago" }
		return fmt.Sprintf("%d years ago", years)
	}
}

func titleCase(s string) string {
	if s == "" {
		return ""
	}
	return strings.ToUpper(s[:1]) + s[1:]
}
