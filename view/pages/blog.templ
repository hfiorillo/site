package pages

import (
	"fmt"
	"strings"
	"time"

	"github.com/hfiorillo/site/models"
	"github.com/hfiorillo/site/view/layout"
)

templ Blog(posts []*models.BlogPost, category string, meta models.PageMeta, recent []*models.BlogPost, old []*models.BlogPost) {
	@layout.Base(meta) {
		if category == "" {
			<h1 class="text-3xl font-bold mb-8">Blog</h1>
		}
		if category != "" {
			<h1 class="text-3xl font-bold mb-1">{ titleCase(category) }</h1>
			<a href="/blog" class="text-base text-base-content/40 hover:text-primary no-underline">all posts</a>
		}
		if len(posts) == 0 {
			<p class="text-base-content/40 mt-12">No posts yet.</p>
		} else {
			for i, post := range recent {
				if i > 0 {
					<hr class="border-0 border-t border-dotted border-base-content/20 my-0"/>
				}
				@BlogCard(post)
			}
			if len(old) > 0 {
				<div class="mt-8 pt-4" x-data="{ open: false }">
					<hr class="border-0 border-t border-dotted border-base-content/20 mb-4"/>
					<button @click="open = !open" class="text-lg text-base-content/40 hover:text-primary transition-colors cursor-pointer">
						<span x-show="!open">▶</span>
						<span x-show="open">▼</span>
						{ fmt.Sprintf("Older posts (%d)", len(old)) }
					</button>
					<div x-show="open" class="mt-4">
						for i, post := range old {
							if i > 0 {
								<hr class="border-0 border-t border-dotted border-base-content/20"/>
							}
							@BlogCard(post)
						}
					</div>
				</div>
			}
		}
	}
}

templ BlogCard(post *models.BlogPost) {
	<article class="py-6" itemscope itemtype="https://schema.org/BlogPosting">
		<meta itemprop="datePublished" content={ post.Date.Format("2006-01-02") }/>
		<meta itemprop="author" content="Harry Fiorillo"/>
		<p class="text-base text-base-content/60 font-semibold mb-2">posted { timeAgo(post.Date) } by Harry Fiorillo</p>
		<a href={ templ.SafeURL(fmt.Sprintf("/blog/%s", post.Filename)) } class="no-underline" itemprop="url">
			<h2 class="text-2xl font-semibold text-base-content hover:text-primary transition-colors" itemprop="headline">{ post.Title }</h2>
		</a>
		<p class="text-lg text-base-content/60 mt-1 leading-relaxed" itemprop="description">{ post.Description }</p>
	</article>
}

templ BlogPage(post *models.BlogPost, prev *models.BlogPost, next *models.BlogPost, meta models.PageMeta) {
	@layout.Base(meta) {
		if meta.StructuredData != "" {
			<script type="application/ld+json">@templ.Raw(meta.StructuredData)</script>
		}
		<article itemscope itemtype="https://schema.org/BlogPosting">
			<meta itemprop="datePublished" content={ post.Date.Format("2006-01-02") }/>
			<meta itemprop="author" content="Harry Fiorillo"/>
			<h1 class="text-3xl font-bold leading-snug" itemprop="headline">{ post.Title }</h1>
			<p class="text-base text-base-content/60 font-semibold mt-3">
				posted { timeAgo(post.Date) } by Harry Fiorillo
				if post.Description != "" {
					{ " — " + post.Description }
				}
			</p>
			<hr class="border-0 border-t border-dotted border-base-content/20 my-8"/>
			<div class="prose prose-lg max-w-none text-justify leading-relaxed" itemprop="articleBody">
				@templ.Raw(post.Content)
			</div>
			if len(post.Metadata.Tags) > 0 {
				<div class="flex flex-wrap gap-3 mt-8 not-prose">
					for _, tag := range post.Metadata.Tags {
						<a href={ templ.SafeURL(fmt.Sprintf("/blog?tag=%s", tag)) } class="text-lg text-base-content/40 hover:text-primary no-underline">{ tag }</a>
					}
				</div>
			}
			<hr class="border-0 border-t border-dotted border-base-content/20 my-8"/>
			<div class="flex justify-between not-prose">
				if prev != nil {
					<a href={ templ.SafeURL(fmt.Sprintf("/blog/%s", prev.Filename)) } class="text-lg text-base-content/60 hover:text-primary no-underline">&larr; { prev.Title }</a>
				} else {
					<div></div>
				}
				if next != nil {
					<a href={ templ.SafeURL(fmt.Sprintf("/blog/%s", next.Filename)) } class="text-lg text-base-content/60 hover:text-primary no-underline">{ next.Title } &rarr;</a>
				}
			</div>
		</article>
	}
}

func timeAgo(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "just now"
	case d < time.Hour:
		m := int(d.Minutes())
		if m == 1 { return "1 minute ago" }
		return fmt.Sprintf("%d minutes ago", m)
	case d < 24*time.Hour:
		h := int(d.Hours())
		if h == 1 { return "1 hour ago" }
		return fmt.Sprintf("%d hours ago", h)
	case d < 7*24*time.Hour:
		days := int(d.Hours() / 24)
		if days == 1 { return "1 day ago" }
		return fmt.Sprintf("%d days ago", days)
	case d < 365*24*time.Hour:
		months := int(d.Hours() / 24 / 30)
		if months == 1 { return "1 month ago" }
		return fmt.Sprintf("%d months ago", months)
	default:
		years := int(d.Hours() / 24 / 365)
		if years == 1 { return "1 year ago" }
		return fmt.Sprintf("%d years ago", years)
	}
}

func titleCase(s string) string {
	if s == "" {
		return ""
	}
	return strings.ToUpper(s[:1]) + s[1:]
}
